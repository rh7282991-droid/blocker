{
  "manifest_version": 3,
  "name": "FocusOS",
  "version": "1.1.0",
  "description": "AI-powered attention protection with custom site redirects",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusOS"
  },
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": {}
}
